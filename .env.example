# 小米 MiMo、DeepSeek 或其他 OpenAI Chat Completions 兼容接口
LLM_API_KEY=填写你的密钥
LLM_BASE_URL=填写接口地址
LLM_MODEL=填写模型名称

# Optional. Blank = local field/keyword search; no Redis service is required.
# Use a Redis deployment with Search enabled for full-text/vector indexes.
HISTORY_REDIS_URL=

# Optional existing local SentenceTransformer model directory. No auto-download.
# For example: D:/models/bge-small-zh-v1.5
HISTORY_EMBEDDING_MODEL_PATH=
